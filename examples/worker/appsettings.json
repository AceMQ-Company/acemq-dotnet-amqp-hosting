{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "acemq": {
    "url": "amqp://guest:guest@localhost:5672",
    "clientName": "orders-worker",
    "listener": {
      "prefetch": 20,
      "concurrency": 2,
      "shutdownTimeout": "00:00:20",
      "retry": {
        "enabled": true,
        "maxAttempts": 4,
        "initialDelay": "00:00:02",
        "maxDelay": "00:05:00",
        "multiplier": 3,
        "jitter": 0.2,
        "brokerWaitThreshold": "00:00:05"
      }
    },
    "topology": {
      "exchanges": [
        { "name": "orders", "type": "topic" }
      ],
      "queues": [
        { "name": "orders.new", "type": "Quorum", "deadLetter": true }
      ],
      "bindings": [
        { "queue": "orders.new", "exchange": "orders", "routingKey": "order.created" }
      ]
    }
  }
}
