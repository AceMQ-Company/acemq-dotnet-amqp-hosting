<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PackageId>AceMq.Amqp.Hosting.OpenTelemetry</PackageId>
    <Description>OpenTelemetry instrumentation registration for AceMQ AMQP: AddAceMqInstrumentation on the tracer and meter builders.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../AceMq.Amqp.Hosting/AceMq.Amqp.Hosting.csproj" />
    <!--
      OpenTelemetry.Api, not OpenTelemetry. Both builders and both Add methods live in
      the API package, so an application keeps its own choice of SDK version and this
      package never pins one.
    -->
    <PackageReference Include="OpenTelemetry.Api" Version="1.15.3" />
  </ItemGroup>

</Project>
